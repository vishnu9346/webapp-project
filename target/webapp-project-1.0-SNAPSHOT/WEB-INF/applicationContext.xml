<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:context="http://www.springframework.org/schema/context"
    xmlns:amq="http://activemq.apache.org/schema/core" xmlns:camel="http://camel.apache.org/schema/spring"
    xmlns:p="http://www.springframework.org/schema/p"
    xsi:schemaLocation="
       http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
       http://activemq.apache.org/schema/core http://activemq.apache.org/schema/core/activemq-core.xsd
       http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd
    ">

  <!-- This creates an embedded ActiveMQ Broker -->
  <broker xmlns="http://activemq.apache.org/schema/core" useJmx="true" persistent="false">
    <transportConnectors>
      <transportConnector uri="tcp://localhost:61616" />
    </transportConnectors>
  </broker>

  <!-- Lets connect the Camel ActiveMQ component to the embedded broker.
       See http://camel.apache.org/activemq.html for more information.
  -->
  <bean id="activemq" class="org.apache.activemq.camel.component.ActiveMQComponent">
    <property name="brokerURL" value="failover:tcp://localhost:61616"/>
  </bean>

  <!-- Power BI Configuration -->
  <bean id="powerBIConfig" class="in.saidemy.webapp.powerbi.PowerBIConfig">
    <property name="tenantId" value="${powerbi.tenant.id:your-tenant-id}"/>
    <property name="clientId" value="${powerbi.client.id:your-client-id}"/>
    <property name="clientSecret" value="${powerbi.client.secret:your-client-secret}"/>
  </bean>

  <!-- Power BI Service -->
  <bean id="powerBIService" class="in.saidemy.webapp.powerbi.PowerBIService">
    <constructor-arg ref="powerBIConfig"/>
  </bean>

  <!-- Power BI Processor -->
  <bean id="powerBIProcessor" class="in.saidemy.webapp.powerbi.PowerBIProcessor">
    <constructor-arg ref="powerBIService"/>
  </bean>

  <!-- Power BI Data Processor -->
  <bean id="powerBIDataProcessor" class="in.saidemy.webapp.powerbi.PowerBIDataProcessor"/>

    <!--
        Here is a sample which processes the input files (leaving them in
        place - see the 'noop' flag), and sends them on a JMS queue. This
        queue is watched by another route which then performs content based
        routing on the messages using XPath.
    -->
    <camelContext xmlns="http://camel.apache.org/schema/spring">
        
        <!-- Original file processing route -->
        <route>
            <from uri="file:src/data?noop=true"/>
            <!-- Print the message to standard out, just as a test -->
            <convertBodyTo type="String"/>
            <to uri="stream:out"/>
            <to uri="activemq:personnel.records"/>
        </route>

        <!-- Power BI REST API Routes -->
        
        <!-- Get all workspaces -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/workspaces?httpMethodRestrict=GET"/>
            <setHeader headerName="operation">
                <constant>workspaces</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Retrieved Power BI workspaces"/>
        </route>
        
        <!-- Get datasets in a workspace -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/workspaces/${header.workspaceId}/datasets?httpMethodRestrict=GET"/>
            <setHeader headerName="operation">
                <constant>datasets</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Retrieved datasets for workspace: ${header.workspaceId}"/>
        </route>
        
        <!-- Get reports in a workspace -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/workspaces/${header.workspaceId}/reports?httpMethodRestrict=GET"/>
            <setHeader headerName="operation">
                <constant>reports</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Retrieved reports for workspace: ${header.workspaceId}"/>
        </route>
        
        <!-- Refresh a dataset -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/workspaces/${header.workspaceId}/datasets/${header.datasetId}/refresh?httpMethodRestrict=POST"/>
            <setHeader headerName="operation">
                <constant>refresh</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Triggered dataset refresh for: ${header.datasetId}"/>
        </route>
        
        <!-- Get refresh history for a dataset -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/workspaces/${header.workspaceId}/datasets/${header.datasetId}/refreshes?httpMethodRestrict=GET"/>
            <setHeader headerName="operation">
                <constant>refreshhistory</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Retrieved refresh history for dataset: ${header.datasetId}"/>
        </route>
        
        <!-- Export a report -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/workspaces/${header.workspaceId}/reports/${header.reportId}/export?httpMethodRestrict=POST"/>
            <setHeader headerName="operation">
                <constant>export</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Triggered report export for: ${header.reportId}"/>
        </route>
        
        <!-- Power BI Authentication endpoint -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/authenticate?httpMethodRestrict=POST"/>
            <setHeader headerName="operation">
                <constant>authenticate</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <log message="Power BI authentication completed"/>
        </route>
        
        <!-- Power BI automated data processing route -->
        <route>
            <from uri="timer://powerbi-automation?period=300000"/>
            <log message="Starting Power BI automation workflow"/>
            <setHeader headerName="operation">
                <constant>workspaces</constant>
            </setHeader>
            <process ref="powerBIProcessor"/>
            <to uri="activemq:powerbi.workspaces"/>
        </route>
        
        <!-- Process Power BI workspaces for automated operations -->
        <route>
            <from uri="activemq:powerbi.workspaces"/>
            <log message="Processing Power BI workspaces for automation"/>
            <to uri="file:target/powerbi/workspaces?fileName=workspaces-${date:now:yyyyMMdd-HHmmss}.json"/>
        </route>
        
        <!-- Enhanced personnel data processing with Power BI transformation -->
        <route>
            <from uri="activemq:personnel.records"/>
            <choice>
                <when>
                    <xpath>/person/city = 'London'</xpath>
                    <log message="UK message - processing for Power BI"/>
                    <setHeader headerName="dataOperation">
                        <constant>transform</constant>
                    </setHeader>
                    <process ref="powerBIDataProcessor"/>
                    <to uri="file:target/messages/uk"/>
                    <to uri="activemq:powerbi.uk.data"/>
                </when>
                <otherwise>
                    <log message="Other message - processing for Power BI"/>
                    <setHeader headerName="dataOperation">
                        <constant>enrich</constant>
                    </setHeader>
                    <process ref="powerBIDataProcessor"/>
                    <to uri="file:target/messages/others"/>
                    <to uri="activemq:powerbi.other.data"/>
                </otherwise>
            </choice>
        </route>
        
        <!-- Power BI Data Transformation endpoint -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/transform?httpMethodRestrict=POST"/>
            <setHeader headerName="dataOperation">
                <constant>transform</constant>
            </setHeader>
            <process ref="powerBIDataProcessor"/>
            <log message="Data transformed for Power BI"/>
        </route>
        
        <!-- Power BI Data Aggregation endpoint -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/aggregate?httpMethodRestrict=POST"/>
            <setHeader headerName="dataOperation">
                <constant>aggregate</constant>
            </setHeader>
            <process ref="powerBIDataProcessor"/>
            <log message="Data aggregated for Power BI"/>
        </route>
        
        <!-- Power BI Data Filtering endpoint -->
        <route>
            <from uri="jetty:http://0.0.0.0:8080/powerbi/filter?httpMethodRestrict=POST"/>
            <setHeader headerName="dataOperation">
                <constant>filter</constant>
            </setHeader>
            <process ref="powerBIDataProcessor"/>
            <log message="Data filtered for Power BI"/>
        </route>
        
        <!-- Process UK data for Power BI -->
        <route>
            <from uri="activemq:powerbi.uk.data"/>
            <log message="Processing UK data for Power BI dashboard"/>
            <to uri="file:target/powerbi/uk?fileName=uk-data-${date:now:yyyyMMdd-HHmmss}.json"/>
        </route>
        
        <!-- Process Other data for Power BI -->
        <route>
            <from uri="activemq:powerbi.other.data"/>
            <log message="Processing other data for Power BI dashboard"/>
            <to uri="file:target/powerbi/other?fileName=other-data-${date:now:yyyyMMdd-HHmmss}.json"/>
        </route>
        
    </camelContext>

</beans>
